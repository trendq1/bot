# === Telegram ===
BOT_TOKEN=123456:ABC...            # от @BotFather
WEBAPP_URL=https://your-domain.com/app/
ADMIN_IDS=                         # ваш Telegram id через запятую

# === Безопасность ===
# Ключ шифрования API-ключей клиентов. Сгенерировать: python -m app.security
# НЕ МЕНЯЙТЕ после запуска — иначе сохранённые ключи клиентов не расшифруются.
ENCRYPTION_KEY=

# === База ===
DATABASE_URL=sqlite+aiosqlite:///./data.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/aitrader

# === ИИ (Anthropic) ===
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5             # можно claude-sonnet-5 — дешевле
AI_INTERVAL_MIN=30                 # как часто анализировать каждую монету

# === Bybit ===
BYBIT_REFERRAL_LINK=https://www.bybit.com/invite?ref=YOURCODE
REQUIRE_REFERRAL=1                 # реальный счёт — только для рефералов
BYBIT_AFFILIATE_API_KEY=           # ключ партнёрского аккаунта (read-only) для проверки рефералов
BYBIT_AFFILIATE_API_SECRET=
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,SUIUSDT,AVAXUSDT,LINKUSDT,ADAUSDT,LTCUSDT
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# === Тарифы (Telegram Stars) ===
PRICE_WEEK_STARS=250
PRICE_MONTH_STARS=750
PRICE_QUARTER_STARS=1900
PAPER_BALANCE=1000

# === Отладка ===
ENGINE_ENABLED=1
DEV_USER_ID=0                      # только локально! открывает API без Telegram
