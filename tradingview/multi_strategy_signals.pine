//@version=6
// ============================================================================
// Multi-Strategy Futures Signals v2 — крипто-фьючерсы (Bybit USDT Perpetual)
//
// ЛОГИКА ВХОДА (два шага):
//   1) ТРЕНД — 10 стратегий голосуют LONG (+1) / SHORT (-1) / нейтрально (0):
//      Supertrend, Parabolic SAR, MACD, CandleTester, CandleTesterMult (старший ТФ),
//      Channel Breakout, Cross SMA, RCI, Open Close Cross, EMA 50/200.
//   2) ТОЧКА ВХОДА — не в погоню за свечой, а после ОТКАТА:
//      цена за последние N свечей коснулась EMA 20, и текущая свеча закрылась
//      в сторону тренда выше/ниже EMA 20 и выше максимума/ниже минимума прошлой свечи.
//      Слишком большая свеча или слишком далеко от EMA — вход пропускается.
//
// СТОП — за локальный минимум/максимум (swing), тейки в R (кратно риску).
// Сделка рисуется зоной от свечи входа до свечи выхода (как инструмент "Длинная позиция").
// Подробности (вход, SL, TP, объём, плечо) — в панели и во всплывающей подсказке метки.
//
// Это инструмент анализа, а не гарантия прибыли. Проверяй на истории и демо-счёте.
// ============================================================================
indicator("Multi-Strategy Futures Signals", shorttitle = "MSFS", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────────── Входные параметры ─────────────────────────────
const string G_SIG  = "Тренд (голосование)"
const string G_ENT  = "Точка входа"
const string G_RISK = "Риск и уровни"
const string G_STR  = "Стратегии"
const string G_VIS  = "Отображение"

reqVotes  = input.int(6, "Мин. голосов за тренд", minval = 1, maxval = 10, group = G_SIG, tooltip = "Сколько стратегий должны согласиться с направлением.")
needST    = input.bool(true, "Только по направлению Supertrend", group = G_SIG)
useTrend  = input.bool(true, "LONG только выше EMA 200, SHORT только ниже", group = G_SIG)
useAdx    = input.bool(true, "Фильтр ADX (не торговать во флэте)", group = G_SIG, inline = "adx")
adxMin    = input.int(20, "мин.", minval = 1, group = G_SIG, inline = "adx")
useVol    = input.bool(false, "Фильтр объёма (объём > среднего)", group = G_SIG, inline = "vol")
volMult   = input.float(1.0, "x", minval = 0.1, step = 0.1, group = G_SIG, inline = "vol")

pbLen     = input.int(20, "EMA отката", minval = 2, group = G_ENT)
pbBars    = input.int(5, "Откат за последние N свечей", minval = 1, group = G_ENT)
pbZone    = input.float(0.3, "Зона касания EMA, ATR", minval = 0.0, step = 0.1, group = G_ENT)
maxBody   = input.float(1.5, "Макс. тело свечи входа, ATR", minval = 0.3, step = 0.1, group = G_ENT, tooltip = "Больше — значит вход в погоню за импульсом, пропускаем.")
maxDist   = input.float(1.5, "Макс. расстояние от EMA отката, ATR", minval = 0.3, step = 0.1, group = G_ENT)
cooldown  = input.int(3, "Пауза после стопа, свечей", minval = 0, group = G_ENT)

deposit   = input.float(1000.0, "Депозит, USDT", minval = 1, group = G_RISK)
riskPct   = input.float(1.0, "Риск на сделку, %", minval = 0.1, maxval = 10, step = 0.1, group = G_RISK)
maxLev    = input.float(10.0, "Макс. плечо (предупреждение)", minval = 1, group = G_RISK)
slMode    = input.string("Swing", "Стоп-лосс", options = ["Swing", "ATR", "Supertrend"], group = G_RISK)
swingLen  = input.int(10, "Swing: свечей назад", minval = 2, group = G_RISK)
atrLen    = input.int(14, "ATR период", minval = 1, group = G_RISK, inline = "atr")
atrMult   = input.float(1.5, "ATR-стоп x", minval = 0.1, step = 0.1, group = G_RISK, inline = "atr")
slMinAtr  = input.float(0.5, "Стоп мин., ATR", minval = 0.1, step = 0.1, group = G_RISK, inline = "slr")
slMaxAtr  = input.float(3.0, "макс., ATR", minval = 0.5, step = 0.1, group = G_RISK, inline = "slr")
tp1R      = input.float(1.0, "TP1 (перенос в безубыток), R", minval = 0.1, step = 0.1, group = G_RISK)
tp2R      = input.float(2.0, "TP2 (полное закрытие), R", minval = 0.2, step = 0.1, group = G_RISK)

useST   = input.bool(true, "1. Supertrend", group = G_STR, inline = "st")
stFact  = input.float(3.0, "фактор", minval = 0.1, step = 0.1, group = G_STR, inline = "st")
stAtr   = input.int(10, "ATR", minval = 1, group = G_STR, inline = "st")
useSAR  = input.bool(true, "2. Parabolic SAR", group = G_STR, inline = "sar")
sarStep = input.float(0.02, "шаг", minval = 0.001, step = 0.01, group = G_STR, inline = "sar")
sarMax  = input.float(0.2, "макс", minval = 0.01, step = 0.01, group = G_STR, inline = "sar")
useMACD = input.bool(true, "3. MACD", group = G_STR, inline = "macd")
macdF   = input.int(12, "", minval = 1, group = G_STR, inline = "macd")
macdS   = input.int(26, "", minval = 1, group = G_STR, inline = "macd")
macdSig = input.int(9, "", minval = 1, group = G_STR, inline = "macd")
useCT   = input.bool(true, "4. CandleTester", group = G_STR, inline = "ct")
ctBars  = input.int(5, "свечей", minval = 2, group = G_STR, inline = "ct")
useCTM  = input.bool(true, "5. CandleTesterMult", group = G_STR, inline = "ctm")
ctmTF   = input.timeframe("60", "старший ТФ", group = G_STR, inline = "ctm")
useCH   = input.bool(true, "6. Channel Breakout", group = G_STR, inline = "ch")
chLen   = input.int(20, "длина", minval = 2, group = G_STR, inline = "ch")
useSMA  = input.bool(true, "7. Cross SMA", group = G_STR, inline = "sma")
smaF    = input.int(9, "", minval = 1, group = G_STR, inline = "sma")
smaS    = input.int(21, "", minval = 2, group = G_STR, inline = "sma")
useRCI  = input.bool(true, "8. RCI", group = G_STR, inline = "rci")
rciLen  = input.int(9, "длина", minval = 3, maxval = 100, group = G_STR, inline = "rci")
useOC   = input.bool(true, "9. Open Close Cross", group = G_STR, inline = "oc")
ocLen   = input.int(8, "EMA", minval = 1, group = G_STR, inline = "oc")
useEMA  = input.bool(true, "10. EMA тренд", group = G_STR, inline = "ema")
emaF    = input.int(50, "", minval = 1, group = G_STR, inline = "ema")
emaS    = input.int(200, "", minval = 2, group = G_STR, inline = "ema")

showZones  = input.bool(true, "Зоны сделок (TP / SL)", group = G_VIS)
showLabels = input.bool(true, "Метки LONG / SHORT (подробности — при наведении)", group = G_VIS)
showExits  = input.bool(true, "Метки выхода (TP / SL / BE / EXIT)", group = G_VIS)
showST     = input.bool(true, "Линия Supertrend", group = G_VIS)
showPB     = input.bool(true, "EMA отката", group = G_VIS)
showEMA    = input.bool(true, "EMA 200", group = G_VIS)
showSAR    = input.bool(false, "Точки Parabolic SAR", group = G_VIS)
showDash   = input.bool(true, "Панель", group = G_VIS, inline = "dash")
dashPos    = input.string("Справа сверху", "", options = ["Справа сверху", "Справа снизу", "Слева сверху", "Слева снизу"], group = G_VIS, inline = "dash")
dashSize   = input.string("Мелкий", "шрифт", options = ["Крошечный", "Мелкий", "Обычный"], group = G_VIS, inline = "dash")

// ───────────────────────────── Цвета ─────────────────────────────
color cLong  = #26a69a
color cShort = #ef5350
color cNeut  = #787b86

// ───────────────────────────── Функции ─────────────────────────────
// Rank Correlation Index: корреляция рангов цены и времени, -100..100
rci(float src, int len) =>
    float d2 = 0.0
    for i = 0 to len - 1
        int rankP = 1
        for j = 0 to len - 1
            if j != i and src[j] > src[i]
                rankP += 1
        int d = (i + 1) - rankP
        d2 += d * d
    (1.0 - 6.0 * d2 / (len * (len * len - 1))) * 100.0

candleDir() =>
    close > open ? 1 : close < open ? -1 : 0

voteText(bool enabled, int v) =>
    not enabled ? "выкл" : v > 0 ? "▲ LONG" : v < 0 ? "▼ SHORT" : "— нейтр."

voteColor(bool enabled, int v) =>
    not enabled ? color.new(cNeut, 70) : v > 0 ? color.new(cLong, 20) : v < 0 ? color.new(cShort, 20) : color.new(cNeut, 40)

// ───────────────────────────── Стратегии (тренд) ─────────────────────────────
[stLine, stDir] = ta.supertrend(stFact, stAtr)
int stVote = stDir < 0 ? 1 : -1

sar = ta.sar(sarStep, sarStep, sarMax)
int sarVote = close > sar ? 1 : -1

[macdLine, sigLine, histLine] = ta.macd(close, macdF, macdS, macdSig)
int macdVote = macdLine > sigLine ? 1 : -1

upCnt = math.sum(close > open ? 1 : 0, ctBars)
dnCnt = math.sum(close < open ? 1 : 0, ctBars)
int ctVote = upCnt > dnCnt ? 1 : dnCnt > upCnt ? -1 : 0

int ctmVote = nz(request.security(syminfo.tickerid, ctmTF, candleDir()[1], lookahead = barmerge.lookahead_on))

upBound = ta.highest(high, chLen)[1]
dnBound = ta.lowest(low, chLen)[1]
var int chVote = 0
if close > upBound
    chVote := 1
else if close < dnBound
    chVote := -1

int smaVote = ta.sma(close, smaF) > ta.sma(close, smaS) ? 1 : -1

rciVal = rci(close, rciLen)
int rciVote = rciVal > 0 ? 1 : rciVal < 0 ? -1 : 0

int ocVote = ta.ema(close, ocLen) > ta.ema(open, ocLen) ? 1 : -1

emaFast = ta.ema(close, emaF)
emaSlow = ta.ema(close, emaS)
int emaVote = close > emaSlow and emaFast > emaSlow ? 1 : close < emaSlow and emaFast < emaSlow ? -1 : 0

int score = (useST ? stVote : 0) + (useSAR ? sarVote : 0) + (useMACD ? macdVote : 0) + (useCT ? ctVote : 0) + (useCTM ? ctmVote : 0) + (useCH ? chVote : 0) + (useSMA ? smaVote : 0) + (useRCI ? rciVote : 0) + (useOC ? ocVote : 0) + (useEMA ? emaVote : 0)
int enabledCnt = (useST ? 1 : 0) + (useSAR ? 1 : 0) + (useMACD ? 1 : 0) + (useCT ? 1 : 0) + (useCTM ? 1 : 0) + (useCH ? 1 : 0) + (useSMA ? 1 : 0) + (useRCI ? 1 : 0) + (useOC ? 1 : 0) + (useEMA ? 1 : 0)
int req = math.max(1, math.min(reqVotes, enabledCnt))

// ───────────────────────────── Фильтры ─────────────────────────────
[diPlus, diMinus, adx] = ta.dmi(14, 14)
volAvg = ta.sma(volume, 20)
atr    = ta.atr(atrLen)

bool adxOk = not useAdx or adx > adxMin
bool volOk = not useVol or volume > volAvg * volMult

bool trendLong  = score >= req and adxOk and volOk and (not useTrend or close > emaSlow) and (not needST or stDir < 0)
bool trendShort = score <= -req and adxOk and volOk and (not useTrend or close < emaSlow) and (not needST or stDir > 0)

// ───────────────────────────── Точка входа: откат + подтверждение ─────────────────────────────
pbEma     = ta.ema(close, pbLen)
lowestPb  = ta.lowest(low, pbBars)
highestPb = ta.highest(high, pbBars)
swingLow  = ta.lowest(low, swingLen)
swingHigh = ta.highest(high, swingLen)

bool bodyOk   = math.abs(close - open) <= atr * maxBody
bool distOk   = math.abs(close - pbEma) <= atr * maxDist
bool pbLong   = lowestPb <= pbEma + atr * pbZone
bool pbShort  = highestPb >= pbEma - atr * pbZone
bool trigLong  = close > open and close > pbEma and close > high[1]
bool trigShort = close < open and close < pbEma and close < low[1]

bool longEntry  = trendLong and pbLong and trigLong and bodyOk and distOk
bool shortEntry = trendShort and pbShort and trigShort and bodyOk and distOk

bool stFlipDn  = stDir > 0 and stDir[1] < 0
bool stFlipUp  = stDir < 0 and stDir[1] > 0

// ───────────────────────────── Позиция, сопровождение, статистика ─────────────────────────────
var int   pos      = 0
var float entry    = na
var float sl       = na
var float slInit   = na
var float tp1      = na
var float tp2      = na
var float riskUnit = na
var int   entryBar = na
var int   lastSlBar = -1000
var bool  beMoved  = false
var float lastQty  = na
var float lastNotional = na
var float lastLev  = na
var int   trades   = 0
var int   wins     = 0
var float sumR     = 0.0
var box   tpBox    = na
var box   slBox    = na

bool longSig  = false
bool shortSig = false
bool slHit    = false
bool beHit    = false
bool tpHit    = false
bool exitHit  = false
float exitR   = na

// Сопровождение открытой позиции (только по закрытым свечам — без перерисовки)
if barstate.isconfirmed and pos != 0 and bar_index > entryBar
    bool isLong = pos == 1
    bool hitSl  = isLong ? low <= sl : high >= sl
    bool hitTp2 = isLong ? high >= tp2 : low <= tp2
    bool hitTp1 = isLong ? high >= tp1 : low <= tp1
    bool flip   = isLong ? stFlipDn : stFlipUp
    if hitSl
        exitR := pos * (sl - entry) / riskUnit
        slHit := not beMoved
        beHit := beMoved
        if not beMoved
            lastSlBar := bar_index
    else if hitTp2
        exitR := tp2R
        tpHit := true
    else
        if not beMoved and hitTp1
            sl := entry
            beMoved := true
        if flip
            exitR := pos * (close - entry) / riskUnit
            exitHit := true
    if showZones
        box.set_right(tpBox, bar_index)
        box.set_right(slBox, bar_index)
    if not na(exitR)
        trades += 1
        wins += exitR > 0 ? 1 : 0
        sumR += exitR
        pos := 0

// Новый вход
bool cooled = bar_index - lastSlBar > cooldown
if barstate.isconfirmed and cooled and ((longEntry and pos != 1) or (shortEntry and pos != -1))
    int dir = longEntry ? 1 : -1
    // Разворот: закрываем противоположную позицию по цене закрытия
    if pos == -dir
        float r = dir * (entry - close) / riskUnit
        trades += 1
        wins += r > 0 ? 1 : 0
        sumR += r
        exitHit := true
        if showZones
            box.set_right(tpBox, bar_index)
            box.set_right(slBox, bar_index)

    float rawDist = switch slMode
        "Swing"      => dir == 1 ? close - swingLow + atr * 0.2 : swingHigh - close + atr * 0.2
        "Supertrend" => math.abs(close - stLine)
        => atr * atrMult
    float slDist = math.min(math.max(rawDist, atr * slMinAtr), atr * slMaxAtr)

    pos      := dir
    entry    := close
    riskUnit := slDist
    sl       := close - dir * slDist
    slInit   := sl
    tp1      := close + dir * slDist * tp1R
    tp2      := close + dir * slDist * tp2R
    entryBar := bar_index
    beMoved  := false
    longSig  := dir == 1
    shortSig := dir == -1

    lastQty      := deposit * riskPct / 100.0 / slDist
    lastNotional := lastQty * close
    lastLev      := lastNotional / deposit

    if showZones
        tpBox := box.new(bar_index, dir == 1 ? tp2 : entry, bar_index, dir == 1 ? entry : tp2, border_color = color.new(cLong, 60), bgcolor = color.new(cLong, 85))
        slBox := box.new(bar_index, dir == 1 ? entry : sl, bar_index, dir == 1 ? sl : entry, border_color = color.new(cShort, 60), bgcolor = color.new(cShort, 85))

    string tip = (dir == 1 ? "LONG" : "SHORT") + " — " + str.tostring(math.abs(score)) + "/" + str.tostring(enabledCnt) + " голосов" +
         "\nВход: " + str.tostring(entry, format.mintick) +
         "\nSL: " + str.tostring(sl, format.mintick) +
         "\nTP1 (БУ): " + str.tostring(tp1, format.mintick) +
         "\nTP2: " + str.tostring(tp2, format.mintick) +
         "\nОбъём: " + str.tostring(lastQty, "#.####") + " (" + str.tostring(lastNotional, "#.##") + " USDT)" +
         "\nПлечо: от x" + str.tostring(math.max(1.0, math.ceil(lastLev * 10) / 10.0), "#.#") +
         (lastLev > maxLev ? "\n⚠ Плечо выше лимита — уменьши риск" : "")
    if showLabels
        label.new(bar_index, dir == 1 ? low : high, dir == 1 ? "L" : "S", yloc = dir == 1 ? yloc.belowbar : yloc.abovebar, style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? cLong : cShort, textcolor = color.white, size = size.tiny, tooltip = tip)

    alert(tip, alert.freq_once_per_bar_close)

// ───────────────────────────── Графика ─────────────────────────────
plot(showST and stDir < 0 ? stLine : na, "Supertrend вверх", color = color.new(cLong, 30), style = plot.style_linebr, linewidth = 1)
plot(showST and stDir > 0 ? stLine : na, "Supertrend вниз", color = color.new(cShort, 30), style = plot.style_linebr, linewidth = 1)
plot(showPB ? pbEma : na, "EMA отката", color = color.new(color.yellow, 30), linewidth = 1)
plot(showEMA ? emaSlow : na, "EMA 200", color = color.new(color.blue, 0), linewidth = 2)
plot(showSAR ? sar : na, "Parabolic SAR", color = color.new(color.orange, 0), style = plot.style_cross, linewidth = 1)

plotshape(longSig and not showLabels, "LONG", shape.triangleup, location.belowbar, cLong, size = size.tiny)
plotshape(shortSig and not showLabels, "SHORT", shape.triangledown, location.abovebar, cShort, size = size.tiny)
plotshape(showExits and slHit, "Стоп", shape.xcross, location.abovebar, cShort, size = size.tiny)
plotshape(showExits and tpHit, "Тейк", shape.diamond, location.abovebar, cLong, size = size.tiny)
plotshape(showExits and beHit, "Безубыток", shape.circle, location.abovebar, cNeut, size = size.tiny)
plotshape(showExits and exitHit, "Выход по развороту", shape.square, location.abovebar, color.orange, size = size.tiny)

alertcondition(longSig, "LONG сигнал", "LONG {{ticker}} по {{close}}")
alertcondition(shortSig, "SHORT сигнал", "SHORT {{ticker}} по {{close}}")
alertcondition(slHit or tpHit or beHit or exitHit, "Позиция закрыта", "{{ticker}}: позиция закрыта (SL / TP / БУ / разворот)")

// ───────────────────────────── Панель ─────────────────────────────
tblPos = switch dashPos
    "Справа снизу" => position.bottom_right
    "Слева сверху" => position.top_left
    "Слева снизу"  => position.bottom_left
    => position.top_right
txtSize = switch dashSize
    "Крошечный" => size.tiny
    "Обычный"   => size.normal
    => size.small

var table dash = table.new(tblPos, 2, 21, bgcolor = color.new(#131722, 10), border_color = color.new(cNeut, 60), border_width = 1)

cellL(int r, string t) =>
    table.cell(dash, 0, r, t, text_color = color.white, text_size = txtSize, text_halign = text.align_left)

cellR(int r, string t, color bg) =>
    table.cell(dash, 1, r, t, text_color = color.white, bgcolor = bg, text_size = txtSize)

vote(int r, string name, bool enabled, int v) =>
    cellL(r, name)
    cellR(r, voteText(enabled, v), voteColor(enabled, v))

if showDash and barstate.islast
    color cNone = color.new(color.black, 100)
    cellL(0, "Стратегия")
    cellR(0, "Голос", cNone)
    vote(1, "Supertrend", useST, stVote)
    vote(2, "Parabolic SAR", useSAR, sarVote)
    vote(3, "MACD", useMACD, macdVote)
    vote(4, "CandleTester", useCT, ctVote)
    vote(5, "CandleTesterMult " + ctmTF, useCTM, ctmVote)
    vote(6, "Channel Breakout", useCH, chVote)
    vote(7, "Cross SMA", useSMA, smaVote)
    vote(8, "RCI " + str.tostring(math.round(rciVal)), useRCI, rciVote)
    vote(9, "Open Close Cross", useOC, ocVote)
    vote(10, "EMA тренд", useEMA, emaVote)
    cellL(11, "Итог (порог " + str.tostring(req) + ")")
    cellR(11, (score > 0 ? "+" : "") + str.tostring(score), color.new(score >= req ? cLong : score <= -req ? cShort : cNeut, 20))
    cellL(12, "ADX / объём")
    cellR(12, str.tostring(math.round(adx)) + (adxOk ? " ✓" : " ✗") + " / " + (volOk ? "✓" : "✗"), adxOk and volOk ? color.new(cLong, 60) : color.new(cShort, 60))
    string nowTxt = trendLong ? (pbLong ? "Тренд ▲, откат есть — ждём свечу" : "Тренд ▲ — ждём откат к EMA") : trendShort ? (pbShort ? "Тренд ▼, откат есть — ждём свечу" : "Тренд ▼ — ждём откат к EMA") : "Нет тренда — ждать"
    cellL(13, "Сейчас")
    cellR(13, nowTxt, color.new(trendLong ? cLong : trendShort ? cShort : cNeut, 40))
    cellL(14, "Позиция")
    cellR(14, pos == 1 ? "LONG" + (beMoved ? " (БУ)" : "") : pos == -1 ? "SHORT" + (beMoved ? " (БУ)" : "") : "нет", color.new(pos == 1 ? cLong : pos == -1 ? cShort : cNeut, 40))
    cellL(15, "Вход / SL")
    cellR(15, na(entry) ? "—" : str.tostring(entry, format.mintick) + " / " + str.tostring(sl, format.mintick), cNone)
    cellL(16, "TP1 / TP2")
    cellR(16, na(entry) ? "—" : str.tostring(tp1, format.mintick) + " / " + str.tostring(tp2, format.mintick), cNone)
    cellL(17, "Объём / плечо")
    cellR(17, na(lastQty) ? "—" : str.tostring(lastQty, "#.####") + " / x" + str.tostring(math.max(1.0, math.ceil(lastLev * 10) / 10.0), "#.#"), na(lastLev) or lastLev <= maxLev ? cNone : color.new(cShort, 40))
    cellL(18, "Сделок / винрейт")
    cellR(18, str.tostring(trades) + " / " + (trades > 0 ? str.tostring(math.round(100.0 * wins / trades)) + "%" : "—"), cNone)
    cellL(19, "Сумма R")
    cellR(19, str.tostring(sumR, "#.##") + "R", color.new(sumR >= 0 ? cLong : cShort, 50))
    cellL(20, "Средний R")
    cellR(20, trades > 0 ? str.tostring(sumR / trades, "#.##") + "R" : "—", cNone)
