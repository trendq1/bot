# Скопируйте в reader.env и заполните. Файл reader.env НЕ публикуйте (chmod 600).
# my.telegram.org → API development tools (под отдельным аккаунтом)
API_ID=
API_HASH=
# Адрес приёма и токен: админка → Сигналы → «Внешний ридер»
INGEST_URL=https://ВАШ-САЙТ/tg/signal-ingest.php
INGEST_TOKEN=
# Каналы через запятую: @username или id (-100…); ALL — все каналы аккаунта. Узнать id: python3 reader.py --list
CHANNELS=
